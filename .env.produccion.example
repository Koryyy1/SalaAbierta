# T11: variables de SalaAbierta en Docker. Copiar como .env (junto a docker-compose.yml) y completar.
# Nunca subir el archivo .env al repositorio.

# :80 = en este equipo, por HTTP (http://localhost, la IP de la red local o detrás de un túnel).
# En un servidor con IP pública, poner el dominio para obtener HTTPS, por ejemplo 54-12-34-56.sslip.io
DOMINIO=:80

# Base de datos (PostgreSQL en el contenedor "db")
DB_NAME=sala_abierta_db
DB_USER=salaabierta
# Cualquier texto largo y aleatorio (por ejemplo, generado con: openssl rand -hex 24)
DB_PASSWORD=

# Cualquier texto largo y aleatorio, de al menos 32 caracteres (openssl rand -hex 48)
JWT_SECRET=

# Opcional: agente IA (HU009). Sin clave funciona en modo básico.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: túnel ngrok con dominio fijo (perfil "ngrok"). Ver DESPLIEGUE.md
NGROK_AUTHTOKEN=
NGROK_DOMINIO=
