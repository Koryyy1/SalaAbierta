# T11: variables del servidor. Copiar como .env (junto a docker-compose.yml) y completar.
# Nunca subir el archivo .env al repositorio.

# Dominio público. Sin dominio propio se puede usar sslip.io con la IP elástica de AWS:
# IP 54.12.34.56  ->  DOMINIO=54-12-34-56.sslip.io
DOMINIO=54-12-34-56.sslip.io

# Base de datos (PostgreSQL en el contenedor "db")
DB_NAME=sala_abierta_db
DB_USER=salaabierta
# Generar con: openssl rand -hex 24
DB_PASSWORD=

# Generar con: openssl rand -hex 48
JWT_SECRET=

# Opcional: agente IA (HU009). Sin clave funciona en modo básico.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
