# Sin DB_HOST se usa PostgreSQL embebido (PGlite). Para PostgreSQL real, completar:
PORT=3000
JWT_SECRET=cambiar-por-un-secreto-largo
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=sala_abierta_db

# Agente IA (HU009). Sin clave, el asistente funciona en modo básico (sin modelo de lenguaje).
# Clave gratuita en https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Producción: NODE_ENV=production exige JWT_SECRET y solo acepta los orígenes web de CORS_ORIGINS.
# NODE_ENV=production
# CORS_ORIGINS=https://app.salaabierta.cl
# Límite de intentos fallidos de inicio de sesión (por IP y correo)
# LOGIN_MAX_INTENTOS=10
# LOGIN_VENTANA_MINUTOS=15
