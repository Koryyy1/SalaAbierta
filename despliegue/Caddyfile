# T11: DOMINIO=:80 sirve por HTTP en el propio equipo (localhost, red local o detrás de un túnel).
# Con un dominio real (por ejemplo 54-12-34-56.sslip.io) Caddy obtiene el certificado HTTPS automáticamente.
{
	servers {
		# Conserva la IP real del visitante cuando llega a través de un túnel (contenedor en la red interna)
		trusted_proxies static private_ranges
	}
}

{$DOMINIO::80} {
	encode zstd gzip

	# La API REST se atiende en el contenedor del backend
	handle /api/* {
		reverse_proxy api:3000
	}

	# Todo lo demás es la versión web de la app (exportación estática de Expo Router)
	handle {
		root * /srv
		try_files {path} {path}.html /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
